# ==========================================
# CONFIGURACIÓN PARA RAILWAY
# Copia estas variables en el dashboard de Railway
# ==========================================

# Puerto de la API (Railway asigna PORT automáticamente)
PORT=2785

# Base de datos - Railway te dará DATABASE_URL automáticamente
# o puedes usar SQLite (recomendado para empezar)
DATABASE_TYPE=sqlite
DATABASE_URL=./data/openwa.sqlite

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/media

# Cache (opcional, puede ser memory para empezar)
CACHE_TYPE=memory

# Dashboard (habilitado)
DASHBOARD_ENABLED=true
DASHBOARD_PORT=2886

# Seguridad - Genera una API key segura
API_KEY=tu-api-key-segura-aqui-cambia-esto

# Webhook (opcional, para recibir mensajes)
# Esto lo configurarás DESPUÉS de tener la URL de Railway
# WEBHOOK_URL=https://tu-app.vercel.app/api/webhooks/whatsapp
# WEBHOOK_SECRET=tu-webhook-secret

# Session config
SESSION_AUTO_START=false
SESSION_HEADLESS=true

# Logging
LOG_LEVEL=info
